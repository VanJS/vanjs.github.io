{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/slides/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Press Start 2P|Silkscreen|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Press Start 2P, Silkscreen, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgendaRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:slot|title|meta|time|key|ref|className|style|children)$/]",
        "message": "<AgendaRow> doesn't accept that prop. Declared props: slot, title, meta, time."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|disabled|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, disabled, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|children|footer|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: kicker, title, children, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:filename|children|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: filename, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='HudBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|pips|pipsOn|key|ref|className|style|children)$/]",
        "message": "<HudBar> doesn't accept that prop. Declared props: items, pips, pipsOn."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePlate'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|hint|style|key|ref|className|style|children)$/]",
        "message": "<ImagePlate> doesn't accept that prop. Declared props: src, alt, hint, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeakerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|src|hint|children|key|ref|className|style|children)$/]",
        "message": "<SpeakerCard> doesn't accept that prop. Declared props: name, role, src, hint, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|solid|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, solid, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:yellow|blue|pink|green)$/]",
        "message": "<Tag> tone must be one of 'yellow' | 'blue' | 'pink' | 'green'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
